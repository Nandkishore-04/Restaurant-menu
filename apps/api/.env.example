ENVIRONMENT=local

# Local Supabase (`pnpm db:start`). For a hosted project use the "Session pooler" or
# direct connection string, with the +asyncpg driver. If you use the transaction pooler
# (port 6543) also set DATABASE_USE_POOLER=true.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_USE_POOLER=false

# Printed by `supabase status` / Project Settings > API
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using legacy shared-secret JWTs. Leave empty to verify via JWKS.
SUPABASE_JWT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GUEST_TOKEN_SECRET=

PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
